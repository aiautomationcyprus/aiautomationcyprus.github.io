---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thank You | AI Automation Cyprus"
  description="Thanks for reaching out. We'll be in touch shortly."
  robots="noindex, nofollow"
>

  <section class="thankyou">
    <div class="thankyou-inner">
      <h1>Message Received</h1>
      <p>Thanks for getting in touch. We'll review your message and get back to you within one business day.</p>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </section>

</BaseLayout>

<style>
  .thankyou {
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    padding: 8rem 2rem 4rem;
  }
  .thankyou-inner { max-width: 520px; margin: 0 auto; width: 100%; }
  h1 { margin-bottom: 1rem; }
  p { color: var(--muted); font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem; }
</style>
