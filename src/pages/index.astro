---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="AI Automation Cyprus | AI &amp; Business Automations"
  description="AI automations and business process automation services in Cyprus. We help businesses save time, reduce costs, and grow with smart automation."
  canonical="https://aiautomationcyprus.github.io/"
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        AI Automation Cyprus
      </div>
      <h1>Stop Doing It<br/>Manually. <span class="accent">Automate It.</span></h1>
      <p class="hero-sub">
        We build AI-powered automations that eliminate repetitive tasks, speed up your operations, and free your team to focus on what actually matters. AI Automation Cyprus is your local partner for fast, practical automation built for businesses across the island.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Get a Free Consultation</a>
        <a href="#services" class="btn-outline">See What We Automate</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="stat-num">80<span>%</span></div>
          <div class="stat-label">Time Saved on Average</div>
        </div>
        <div>
          <div class="stat-num">48<span>h</span></div>
          <div class="stat-label">First Automation Live</div>
        </div>
        <div>
          <div class="stat-num">0<span>€</span></div>
          <div class="stat-label">Consultation Fee</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY AUTOMATE -->
  <section class="why" id="why">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">Why Automate</span>
        <h2>Your Business Is Losing Time Every Day</h2>
        <div class="section-divider"></div>
        <p class="section-desc">Manual processes are slow, error-prone, and expensive. Automation fixes all three, often within days, not months.</p>
      </div>
      <div class="why-list">
        <div class="why-item">
          <h3>Save Hours Every Week</h3>
          <p>Repetitive tasks like data entry, follow-up emails, report generation, and scheduling can be fully automated, running 24/7 without your input.</p>
        </div>
        <div class="why-item">
          <h3>Eliminate Human Error</h3>
          <p>Automated workflows run exactly the same way every single time. No missed steps, no copy-paste mistakes, no forgotten follow-ups.</p>
        </div>
        <div class="why-item">
          <h3>Scale Without Hiring</h3>
          <p>Handle 10x the workload with the same team. Automations grow with your business. No extra headcount, no extra cost.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">What We Build</span>
        <h2>AI Automation Services</h2>
        <div class="section-divider"></div>
        <p class="section-desc">From simple workflow automations to complex AI systems. AI Automation Cyprus designs, builds, and deploys the right solution for your business.</p>
      </div>
      <div class="services-grid">

        <div class="service-card">
          <div class="service-num">01</div>
          <div>
            <h3>Workflow &amp; Process Automation</h3>
            <p>Connect your existing tools (CRM, email, spreadsheets, forms) and automate the flow between them. Built with Make, Zapier, or custom code.</p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-num">02</div>
          <div>
            <h3>AI Chatbots &amp; Virtual Assistants</h3>
            <p>Custom AI chatbots trained on your business data. Answer customer questions, qualify leads, and book appointments automatically, 24/7.</p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-num">03</div>
          <div>
            <h3>Lead Generation &amp; Follow-Up</h3>
            <p>Automate your entire lead pipeline, from capture and enrichment to personalised follow-up sequences and CRM updates. Never lose a lead again.</p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-num">04</div>
          <div>
            <h3>Document &amp; Data Processing</h3>
            <p>Extract data from invoices, forms, and emails using AI. Automatically organise, validate, and push data where it needs to go. Zero manual input.</p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-num">05</div>
          <div>
            <h3>Reporting &amp; Dashboards</h3>
            <p>Automated daily, weekly, or monthly reports delivered straight to your inbox or Slack. Always know what's happening in your business.</p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-num">06</div>
          <div>
            <h3>E-Commerce &amp; Booking Automation</h3>
            <p>Order processing, inventory alerts, customer notifications, appointment reminders: automate the operational backbone of your online business.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="process" id="process">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">Our Process</span>
        <h2>From First Call to Live Automation</h2>
        <div class="section-divider"></div>
        <p class="section-desc">At AI Automation Cyprus, we keep it simple. No lengthy projects, no complex contracts. Just fast, effective automations that work.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">Step 1</div>
          <h3>Free Discovery Call</h3>
          <p>We learn about your business, your biggest time drains, and where automation would have the most impact. No commitment, no jargon.</p>
        </div>
        <div class="step">
          <div class="step-num">Step 2</div>
          <h3>We Build It</h3>
          <p>Our team designs and builds your automation, typically within 48 to 72 hours for standard workflows, slightly longer for AI-powered systems.</p>
        </div>
        <div class="step">
          <div class="step-num">Step 3</div>
          <h3>You Save Time</h3>
          <p>Your automation goes live. We test everything, train your team, and stay available for adjustments. You focus on growing your business.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="industries" id="industries">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">Industries</span>
        <h2>We Work Across All Sectors</h2>
        <div class="section-divider"></div>
        <p class="section-desc">If your business has repetitive processes, we can automate them. Here are the sectors we work with most in Cyprus.</p>
      </div>
      <div class="industry-list">
        <div class="industry-chip"><span class="chip-dot"></span>Real Estate</div>
        <div class="industry-chip"><span class="chip-dot"></span>Legal &amp; Accounting</div>
        <div class="industry-chip"><span class="chip-dot"></span>Hospitality &amp; Tourism</div>
        <div class="industry-chip"><span class="chip-dot"></span>E-Commerce</div>
        <div class="industry-chip"><span class="chip-dot"></span>Healthcare &amp; Clinics</div>
        <div class="industry-chip"><span class="chip-dot"></span>Construction</div>
        <div class="industry-chip"><span class="chip-dot"></span>Retail</div>
        <div class="industry-chip"><span class="chip-dot"></span>Financial Services</div>
        <div class="industry-chip"><span class="chip-dot"></span>Marketing Agencies</div>
        <div class="industry-chip"><span class="chip-dot"></span>Education</div>
        <div class="industry-chip"><span class="chip-dot"></span>Logistics</div>
        <div class="industry-chip"><span class="chip-dot"></span>Restaurants &amp; Food</div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="contact-inner">
      <div class="contact-info">
        <span class="section-tag">Get In Touch</span>
        <h2>Let's Automate Your Business</h2>
        <div class="section-divider"></div>
        <p>Tell us what you're spending too much time on. AI Automation Cyprus will map out a practical automation plan. Free, no commitment, no sales pressure.</p>

        <div class="contact-detail">
          <div class="contact-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="white" stroke-width="2"/>
              <path d="M3 7 L12 13 L21 7" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <strong>Email</strong>
            <a href="mailto:hello@automationcyprus.com">hello@automationcyprus.com</a>
          </div>
        </div>

        <div class="contact-detail">
          <div class="contact-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="rgba(255,255,255,0.85)"/>
              <circle cx="12" cy="9" r="2.5" fill="#0d9488"/>
            </svg>
          </div>
          <div>
            <strong>Based In</strong>
            <span>Nicosia, Limassol, Larnaca, Paphos, Famagusta, Protaras, Ayia Napa &amp; across Cyprus</span>
          </div>
        </div>
      </div>

      <form class="contact-form" action="https://formspree.io/f/xkjwaalr" method="POST">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required />
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" required />
        </div>
        <div class="form-group">
          <label for="business">Type of Business</label>
          <input type="text" id="business" name="business" placeholder="e.g. Real estate agency, restaurant..." />
        </div>
        <div class="form-group">
          <label for="message">What do you want to automate?</label>
          <textarea id="message" name="message" placeholder="Describe the tasks or processes taking up most of your time..."></textarea>
        </div>
        <div class="form-submit">
          <button type="submit" class="btn-primary">Send Message &rarr;</button>
        </div>
      </form>
    </div>
  </section>

</BaseLayout>
