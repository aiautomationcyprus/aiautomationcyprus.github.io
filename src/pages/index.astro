---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepage as h } from '../data/homepage';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "AI Automation Cyprus",
  "url": "https://ai-cyp.com",
  "logo": "https://ai-cyp.com/og-image.png",
  "description": "AI automations and business process automation services in Cyprus. We help businesses save time, reduce costs, and grow with smart automation.",
  "email": "hello@automationcyprus.com",
  "areaServed": [
    "Nicosia", "Limassol", "Larnaca", "Paphos", "Famagusta", "Protaras", "Ayia Napa", "Cyprus"
  ],
  "serviceType": [
    "Workflow Automation", "AI Chatbots", "Lead Generation Automation",
    "Document Processing", "Reporting Automation", "E-Commerce Automation"
  ],
  "sameAs": []
});
---
<BaseLayout
  title="AI Automation Cyprus | AI &amp; Business Automations"
  description="AI automations and business process automation services in Cyprus. We help businesses save time, reduce costs, and grow with smart automation."
  canonical="https://ai-cyp.com/"
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-badge">{h.hero.badge}</p>
      <h1>{h.hero.heading}<br/> <span class="accent">{h.hero.headingAccent}</span></h1>
      <p class="hero-sub">{h.hero.sub}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">{h.hero.ctaPrimary}</a>
        <a href="#services" class="btn-outline">{h.hero.ctaSecondary}</a>
      </div>
      <div class="hero-stats">
        {h.hero.stats.map(s => (
          <div>
            <div class="stat-num">{s.num}<span>{s.unit}</span></div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY AUTOMATE -->
  <section class="why" id="why">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">{h.why.tag}</span>
        <h2>{h.why.heading}</h2>
                <p class="section-desc">{h.why.desc}</p>
      </div>
      <div class="why-list">
        {h.why.items.map(item => (
          <div class="why-item">
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">{h.services.tag}</span>
        <h2>{h.services.heading}</h2>
                <p class="section-desc">{h.services.desc}</p>
      </div>
      <div class="services-grid">
        {h.services.items.map(item => (
          <div class="service-card">
            <div class="service-num">{item.num}</div>
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="process" id="process">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">{h.process.tag}</span>
        <h2>{h.process.heading}</h2>
                <p class="section-desc">{h.process.desc}</p>
      </div>
      <div class="steps">
        {h.process.steps.map(step => (
          <div class="step">
            <div class="step-num">{step.num}</div>
            <h3>{step.heading}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="industries" id="industries">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-tag">{h.industries.tag}</span>
        <h2>{h.industries.heading}</h2>
                <p class="section-desc">{h.industries.desc}</p>
      </div>
      <ul class="industry-list">
        {h.industries.list.map(name => (
          <li>{name}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="contact-inner">
      <div class="contact-info">
        <span class="section-tag">{h.contact.tag}</span>
        <h2>{h.contact.heading}</h2>
                <p>{h.contact.body}</p>

        <dl class="contact-details">
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${h.contact.email}`}>{h.contact.email}</a></dd>
          </div>
          <div>
            <dt>Phone / WhatsApp</dt>
            <dd><a href={`tel:${h.contact.phoneHref}`}>{h.contact.phone}</a></dd>
          </div>
          <div>
            <dt>Serving</dt>
            <dd>{h.contact.location}</dd>
          </div>
        </dl>
      </div>

      <form class="contact-form" action="https://formspree.io/f/xkjwaalr" method="POST">
        <input type="hidden" name="_next" value="https://ai-cyp.com/thank-you/" />
        <div class="form-group">
          <label for="name">{h.contact.formFields.name.label}</label>
          <input type="text" id="name" name="name" placeholder={h.contact.formFields.name.placeholder} required />
        </div>
        <div class="form-group">
          <label for="email">{h.contact.formFields.email.label}</label>
          <input type="email" id="email" name="email" placeholder={h.contact.formFields.email.placeholder} required />
        </div>
        <div class="form-group">
          <label for="business">{h.contact.formFields.business.label}</label>
          <input type="text" id="business" name="business" placeholder={h.contact.formFields.business.placeholder} />
        </div>
        <div class="form-group">
          <label for="message">{h.contact.formFields.message.label}</label>
          <textarea id="message" name="message" placeholder={h.contact.formFields.message.placeholder}></textarea>
        </div>
        <p class="form-note">{h.contact.formFields.note}</p>
        <div class="form-submit">
          <button type="submit" class="btn-primary">{h.contact.formFields.submit} &rarr;</button>
        </div>
      </form>
    </div>
  </section>

</BaseLayout>
