---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  schema?: string;
  footer?: string;
}

const {
  title,
  description = 'AI automations and business process automation services in Cyprus. We help businesses save time, reduce costs, and grow with smart automation.',
  canonical,
  robots,
  schema,
  footer = 'AI & Business Automation across Cyprus. All rights reserved.',
} = Astro.props;

const siteName = 'AI Automation Cyprus';
const ogImage = 'https://ai-cyp.com/og-image.png';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  {robots && <meta name="robots" content={robots} />}

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD -->
  {schema && <script type="application/ld+json" set:html={schema} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">
      <span class="nav-logo-text">AI Automation <span>Cyprus</span></span>
    </a>
    <ul class="nav-links">
      <li><a href="/ai-agency-cyprus/">AI Agency</a></li>
      <li><a href="/ai-for-hotels-tourism-cyprus/">AI for Hotels &amp; Tourism</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/#contact">Contact</a></li>
      <li><a href="tel:+35797603083" class="nav-cta">+357 97 603083</a></li>
    </ul>
  </nav>

  <slot />

  <!-- FOOTER -->
  <footer>
    <p>&copy; 2026 AI Automation Cyprus. {footer}</p>
  </footer>

</body>
</html>
